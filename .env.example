# Public Credit Opportunity Engine — environment variables
# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# FRED_API_KEY: register at https://fred.stlouisfed.org/docs/api/api_keys.html (free)
FRED_API_KEY=REPLACE_ME
#
# FINRA API Platform Public Credential (free, individual, non-commercial):
#   https://gateway.finra.org/app/dfo-console -> Create Account (Individual)
#   -> API Console -> Public Credential. Only public aggregated datasets are
#   used (CORPORATEMARKETBREADTH, CORPORATESANDAGENCIESCAPPEDVOLUME).
FINRA_API_CLIENT_ID=REPLACE_ME
FINRA_API_SECRET=REPLACE_ME
#
# Alpaca free developer tier (paper trading):
#   https://alpaca.markets -> dashboard -> API Keys. Used for a live
#   SGOV (0-3 month T-bill ETF) last-trade quote enrichment; no trading is
#   ever placed.
ALPACA_API_KEY=REPLACE_ME
ALPACA_API_SECRET=REPLACE_ME
#
# Nasdaq Data Link (ex-Quandl) free API key:
#   https://data.nasdaq.com -> Sign up (free) -> API Keys. Adds the daily
#   USTREASURY/YIELD full curve (nominal + real) as a second curve source.
NASDAQ_DATA_LINK_API_KEY=REPLACE_ME
#
# Polygon.io free plan API key:
#   https://polygon.io/dashboard/signup -> Free. Adds full listed-options
#   chains for credit ETFs (25-delta put skew accrual for the skew leg).
POLYGON_API_KEY=REPLACE_ME
#
# Optional portal layer (multi-asset heatmap spec §4): local PostgreSQL DSN.
#   Easiest: bring up the included Docker stack (postgis + redis) with
#     docker compose up -d
#   then use exactly these two URLs in .env. Apply the schema once:
#     psql "$DATABASE_URL" -f sql/heatmap_schema.sql
#   Requires:  pip install "psycopg[binary]"
#   Leave unset (or REPLACE_ME) to keep data/atlas.json as the live store —
#   `python cli.py --market atlas --db` then reports UNAVAILABLE honestly.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/heatmap
#
# Optional portal cache (multi-asset heatmap spec §1): local Redis URL.
#   The API (python -m api.server) then serves the parsed atlas doc from
#   Redis, keyed on the file's mtime (no TTL constants). Leave unset to keep
#   the honest JSON-file fallback. Requires:  pip install redis
REDIS_URL=redis://127.0.0.1:6379/0
